# ---------------------------------------------------------------------------
# Mum Where's My Cards — Arbitrage Engine — environment template
#
# LOCAL DEV: copy relevant values into apps/worker/.dev.vars (gitignored).
#            `wrangler dev` reads .dev.vars automatically.
# PRODUCTION: never put secrets in wrangler.toml. Set each secret with:
#            wrangler secret put <NAME>
# CLIENT-SIDE: none of these may ever be referenced from apps/web — the SPA
#            only talks to this Worker's own /api/* routes, which hold the
#            keys server-side.
# ---------------------------------------------------------------------------

# --- eBay Browse API (live listings; supply-side data only) -----------------
# Developer account: https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace to query, e.g. EBAY_GB or EBAY_US
EBAY_MARKETPLACE_ID=EBAY_GB
# OAuth scope for Browse API (client credentials grant)
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope

# --- PokeTrace API (raw/graded market & pricing data) ------------------------
# Abstracted behind packages/providers/src/market/MarketDataProvider.ts —
# swapping providers later (PriceCharting, PkmnPrices, Cardmarket) never
# touches business logic, only a new adapter + this config block.
POKETRACE_API_KEY=
POKETRACE_API_BASE_URL=https://api.poketrace.com

# --- Provider selection (also settable per-environment in wrangler.toml) ----
# 'mock' uses packages/providers/src/fixtures — always used for local tests.
MARKET_PROVIDER=poketrace
EBAY_PROVIDER=ebay-browse

# --- Cloudflare Access (private auth on mumwheresmycards.com/arbitrage) -----
# Team domain shown in Zero Trust dashboard, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# AUD tag of the Access application protecting this route (Zero Trust ->
# Access -> Applications -> your app -> Overview -> Application Audience (AUD) Tag)
CF_ACCESS_AUD=

# --- Cloudflare D1 -----------------------------------------------------------
# Created via `wrangler d1 create mwmc-db`; id goes into wrangler.toml
# (database_id is not secret, but keeping it here for local reference).
D1_DATABASE_ID=

# --- Cloudflare account / API token (for CI deploys only) -------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Fee schedule overrides (optional; defaults live in the `settings` table
#     and are editable in the dashboard Settings tab — these env vars are only
#     for bootstrapping a fresh environment before the DB is seeded) ---------
DEFAULT_CURRENCY=GBP
