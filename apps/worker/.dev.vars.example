# Copy to apps/worker/.dev.vars (gitignored) for `wrangler dev` / `wrangler d1` local runs.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
POKETRACE_API_KEY=
POKETRACE_API_BASE_URL=https://api.poketrace.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# AI INTELLIGENCE Phase 2 — leave OPENAI_API_KEY blank and every AI feature
# stays a no-op (NullAiModelProvider) — see packages/providers/src/ai/. The
# three model-tier vars are optional; they default to the confirmed-real
# GPT-5.6 family (Luna/Terra/Sol) — see createAiModelProvider.ts.
OPENAI_API_KEY=

AI_FAST_MODEL=gpt-5.6-luna
AI_DEEP_MODEL=gpt-5.6-terra
AI_AUDIT_MODEL=gpt-5.6-sol
