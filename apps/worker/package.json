{
  "name": "@mwmc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "dev:live-local": "wrangler dev --env live_local",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply mwmc-db --local",
    "migrate:remote": "wrangler d1 migrations apply mwmc-db --remote",
    "migrate:live-local": "wrangler d1 migrations apply mwmc-db-live-local --local --env live_local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:watchlist": "tsx scripts/import-watchlist.ts seed/watchlist.json > seed/watchlist.generated.sql",
    "poketrace:smoke": "tsx scripts/poketrace-smoke-test.ts",
    "poketrace:catalogue-smoke": "tsx scripts/poketrace-catalogue-smoke-test.ts",
    "ebay:smoke": "tsx scripts/ebay-smoke-test.ts",
    "openai:smoke": "tsx scripts/openai-smoke-test.ts",
    "listing-analyst:eval": "tsx scripts/listing-analyst-eval.ts"
  },
  "dependencies": {
    "@mwmc/core": "workspace:*",
    "@mwmc/providers": "workspace:*",
    "@mwmc/db": "workspace:*",
    "hono": "^4.6.9",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "wrangler": "^4.127.1",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
